# Bicep build artifacts (compiled ARM templates / parameter files)
main.json
**/main.json
**/tier0.json
*.bicepparam.json

# Bicepparam backups written by Set-BicepParamCertUri.ps1 / Initialize-RdsFarm.ps1
*.bicepparam.bak
*.bak

# Local-only param overrides (never committed)
*.local.bicepparam
*.local.json

# DSC artifacts (regenerated by Publish-DscArtifact.ps1)
Configuration.zip

# Certificate material — NEVER commit private keys
*.pfx
*.p12
*.key
*.pem
*.csr
*.cer
*.crt

# Local env-var dumps
.env
.env.*
!.env.example

# Persisted Step 1 answers from Initialize-RdsFarm.ps1 (contains subscription
# IDs, AD domain names, internal IPs, allowed source CIDRs). Keep local.
.rds-farm-init.config.psd1
*.rds-farm-init.config.psd1
