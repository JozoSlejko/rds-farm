{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "languageVersion": "2.0",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.43.8.12551",
      "templateHash": "12714976785754253256"
    }
  },
  "parameters": {
    "namePrefix": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "tags": {
      "type": "object"
    },
    "artifactsStorageAccountName": {
      "type": "string",
      "metadata": {
        "description": "Name of the artifacts storage account. The UAMI is granted Storage Blob Data Reader on it so the DSC extension can pull Configuration.zip with managed-identity auth (no SAS)."
      }
    },
    "artifactsStorageAccountResourceGroup": {
      "type": "string",
      "metadata": {
        "description": "Resource group of the artifacts storage account."
      }
    },
    "enableKeyVaultRole": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "When true, also grant the UAMI Key Vault Secrets User on the cert vault (so the Key Vault VM extension can pull the cert)."
      }
    },
    "keyVaultName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Required when enableKeyVaultRole = true."
      }
    },
    "keyVaultResourceGroup": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Required when enableKeyVaultRole = true."
      }
    }
  },
  "resources": {
    "uami": {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "[format('{0}-vm-uami', parameters('namePrefix'))]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]"
    },
    "saRole": {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "[format('saRole-{0}', uniqueString('saRole', deployment().name))]",
      "resourceGroup": "[parameters('artifactsStorageAccountResourceGroup')]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "storageAccountName": {
            "value": "[parameters('artifactsStorageAccountName')]"
          },
          "principalId": {
            "value": "[reference('uami').principalId]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.43.8.12551",
              "templateHash": "12224760424205124389"
            }
          },
          "parameters": {
            "storageAccountName": {
              "type": "string",
              "metadata": {
                "description": "Name of the existing storage account hosting the DSC artifacts."
              }
            },
            "principalId": {
              "type": "string",
              "metadata": {
                "description": "Principal ID of the user-assigned managed identity that needs read access to the blob."
              }
            }
          },
          "variables": {
            "blobDataReaderRoleId": "2a2b9908-6ea1-4ae2-8e65-a410df84e7d1"
          },
          "resources": [
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "scope": "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]",
              "name": "[guid(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), parameters('principalId'), variables('blobDataReaderRoleId'))]",
              "properties": {
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('blobDataReaderRoleId'))]",
                "principalId": "[parameters('principalId')]",
                "principalType": "ServicePrincipal"
              }
            }
          ]
        }
      },
      "dependsOn": [
        "uami"
      ]
    },
    "kvRole": {
      "condition": "[parameters('enableKeyVaultRole')]",
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "[format('kvRole-{0}', uniqueString('kvRole', deployment().name))]",
      "resourceGroup": "[parameters('keyVaultResourceGroup')]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "keyVaultName": {
            "value": "[parameters('keyVaultName')]"
          },
          "principalId": {
            "value": "[reference('uami').principalId]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.43.8.12551",
              "templateHash": "13378224402290953267"
            }
          },
          "parameters": {
            "keyVaultName": {
              "type": "string",
              "metadata": {
                "description": "Name of the existing Key Vault to grant access on."
              }
            },
            "principalId": {
              "type": "string",
              "metadata": {
                "description": "Principal ID of the user-assigned managed identity."
              }
            }
          },
          "variables": {
            "secretsUserRoleId": "4633458b-17de-408a-b874-0445c86b69e6"
          },
          "resources": [
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "scope": "[resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName'))]",
              "name": "[guid(resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName')), parameters('principalId'), variables('secretsUserRoleId'))]",
              "properties": {
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('secretsUserRoleId'))]",
                "principalId": "[parameters('principalId')]",
                "principalType": "ServicePrincipal"
              }
            }
          ]
        }
      },
      "dependsOn": [
        "uami"
      ]
    }
  },
  "outputs": {
    "identityId": {
      "type": "string",
      "value": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-vm-uami', parameters('namePrefix')))]"
    },
    "identityClientId": {
      "type": "string",
      "value": "[reference('uami').clientId]"
    },
    "identityPrincipalId": {
      "type": "string",
      "value": "[reference('uami').principalId]"
    }
  }
}