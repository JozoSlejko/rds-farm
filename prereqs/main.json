{
  "$schema": "https://schema.management.azure.com/schemas/2018-05-01/subscriptionDeploymentTemplate.json#",
  "languageVersion": "2.0",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.43.8.12551",
      "templateHash": "4223743795863989961"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[deployment().location]",
      "metadata": {
        "description": "Azure region for the prereq resource groups and resources."
      }
    },
    "storageResourceGroupName": {
      "type": "string",
      "defaultValue": "rds-artifacts-rg",
      "metadata": {
        "description": "Resource group that will hold the DSC artifacts storage account."
      }
    },
    "keyVaultResourceGroupName": {
      "type": "string",
      "defaultValue": "rds-security-rg",
      "metadata": {
        "description": "Resource group that will hold the TLS-cert Key Vault. Ignored when deployKeyVault = false."
      }
    },
    "storageAccountName": {
      "type": "string",
      "minLength": 3,
      "maxLength": 24,
      "metadata": {
        "description": "Globally unique storage account name (3-24 chars, lowercase alphanumeric)."
      }
    },
    "keyVaultName": {
      "type": "string",
      "defaultValue": "",
      "maxLength": 24,
      "metadata": {
        "description": "Globally unique Key Vault name (3-24 chars). Required when deployKeyVault = true."
      }
    },
    "artifactsContainerName": {
      "type": "string",
      "defaultValue": "dsc",
      "metadata": {
        "description": "Blob container that will hold Configuration.zip and any other DSC artifacts."
      }
    },
    "adminPrincipals": {
      "type": "array",
      "metadata": {
        "description": "Admin principals that get full data-plane access on the prereq resources. Always include the CI service principal so the deploy pipeline can upload artifacts and (later) manage certs. Each item: { id: <Entra object ID>, type: User | Group | ServicePrincipal }."
      }
    },
    "deployKeyVault": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Set to false to skip Key Vault (e.g. when enableCertificateBinding = false in the main farm)."
      }
    },
    "keyVaultEnablePurgeProtection": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Enable purge protection on the Key Vault (irreversible; vault cannot be permanently deleted for 90 days). Recommended true for production."
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {
        "workload": "RemoteDesktopServices",
        "purpose": "prereqs"
      },
      "metadata": {
        "description": "Tags applied to both the resource groups and the resources inside."
      }
    }
  },
  "resources": {
    "artifactsRg": {
      "type": "Microsoft.Resources/resourceGroups",
      "apiVersion": "2024-03-01",
      "name": "[parameters('storageResourceGroupName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]"
    },
    "securityRg": {
      "condition": "[parameters('deployKeyVault')]",
      "type": "Microsoft.Resources/resourceGroups",
      "apiVersion": "2024-03-01",
      "name": "[parameters('keyVaultResourceGroupName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]"
    },
    "storage": {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "[format('storage-{0}', uniqueString('storage', deployment().name))]",
      "resourceGroup": "[parameters('storageResourceGroupName')]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "storageAccountName": {
            "value": "[parameters('storageAccountName')]"
          },
          "artifactsContainerName": {
            "value": "[parameters('artifactsContainerName')]"
          },
          "adminPrincipals": {
            "value": "[parameters('adminPrincipals')]"
          },
          "location": {
            "value": "[parameters('location')]"
          },
          "tags": {
            "value": "[parameters('tags')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.43.8.12551",
              "templateHash": "16491546886227621122"
            }
          },
          "parameters": {
            "storageAccountName": {
              "type": "string",
              "minLength": 3,
              "maxLength": 24,
              "metadata": {
                "description": "Globally unique storage account name (3-24 chars, lowercase alphanumeric)."
              }
            },
            "artifactsContainerName": {
              "type": "string",
              "defaultValue": "dsc",
              "metadata": {
                "description": "Blob container that will hold Configuration.zip and any other DSC artifacts."
              }
            },
            "adminPrincipals": {
              "type": "array",
              "metadata": {
                "description": "Admin principals that get Storage Blob Data Contributor on the account. Each item must be { id: <Entra object ID>, type: User | Group | ServicePrincipal }."
              }
            },
            "location": {
              "type": "string"
            },
            "tags": {
              "type": "object"
            }
          },
          "variables": {
            "blobDataContributorRoleId": "ba92f5b4-2d11-453d-a403-e96b0029c9fe"
          },
          "resources": [
            {
              "type": "Microsoft.Storage/storageAccounts",
              "apiVersion": "2024-01-01",
              "name": "[parameters('storageAccountName')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "sku": {
                "name": "Standard_LRS"
              },
              "kind": "StorageV2",
              "properties": {
                "accessTier": "Hot",
                "allowBlobPublicAccess": false,
                "allowSharedKeyAccess": false,
                "defaultToOAuthAuthentication": true,
                "minimumTlsVersion": "TLS1_2",
                "supportsHttpsTrafficOnly": true,
                "publicNetworkAccess": "Enabled",
                "networkAcls": {
                  "defaultAction": "Allow",
                  "bypass": "AzureServices"
                }
              }
            },
            {
              "type": "Microsoft.Storage/storageAccounts/blobServices",
              "apiVersion": "2024-01-01",
              "name": "[format('{0}/{1}', parameters('storageAccountName'), 'default')]",
              "properties": {
                "deleteRetentionPolicy": {
                  "enabled": true,
                  "days": 7
                },
                "containerDeleteRetentionPolicy": {
                  "enabled": true,
                  "days": 7
                }
              },
              "dependsOn": [
                "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]"
              ]
            },
            {
              "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
              "apiVersion": "2024-01-01",
              "name": "[format('{0}/{1}/{2}', parameters('storageAccountName'), 'default', parameters('artifactsContainerName'))]",
              "properties": {
                "publicAccess": "None"
              },
              "dependsOn": [
                "[resourceId('Microsoft.Storage/storageAccounts/blobServices', parameters('storageAccountName'), 'default')]"
              ]
            },
            {
              "copy": {
                "name": "adminRoleAssignments",
                "count": "[length(parameters('adminPrincipals'))]"
              },
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "scope": "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]",
              "name": "[guid(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), parameters('adminPrincipals')[copyIndex()].id, variables('blobDataContributorRoleId'))]",
              "properties": {
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('blobDataContributorRoleId'))]",
                "principalId": "[parameters('adminPrincipals')[copyIndex()].id]",
                "principalType": "[parameters('adminPrincipals')[copyIndex()].type]"
              },
              "dependsOn": [
                "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]"
              ]
            }
          ],
          "outputs": {
            "storageAccountName": {
              "type": "string",
              "value": "[parameters('storageAccountName')]"
            },
            "storageAccountId": {
              "type": "string",
              "value": "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]"
            },
            "artifactsLocation": {
              "type": "string",
              "value": "[format('{0}{1}/', reference(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), '2024-01-01').primaryEndpoints.blob, parameters('artifactsContainerName'))]"
            }
          }
        }
      },
      "dependsOn": [
        "artifactsRg"
      ]
    },
    "keyVault": {
      "condition": "[parameters('deployKeyVault')]",
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "[format('keyVault-{0}', uniqueString('keyVault', deployment().name))]",
      "resourceGroup": "[parameters('keyVaultResourceGroupName')]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "keyVaultName": {
            "value": "[parameters('keyVaultName')]"
          },
          "adminPrincipals": {
            "value": "[parameters('adminPrincipals')]"
          },
          "enablePurgeProtection": {
            "value": "[parameters('keyVaultEnablePurgeProtection')]"
          },
          "location": {
            "value": "[parameters('location')]"
          },
          "tags": {
            "value": "[parameters('tags')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.43.8.12551",
              "templateHash": "299215079924832186"
            }
          },
          "parameters": {
            "keyVaultName": {
              "type": "string",
              "minLength": 3,
              "maxLength": 24,
              "metadata": {
                "description": "Globally unique Key Vault name (3-24 chars)."
              }
            },
            "adminPrincipals": {
              "type": "array",
              "metadata": {
                "description": "Admin principals that get Key Vault Certificates Officer on the vault. Each item must be { id: <Entra object ID>, type: User | Group | ServicePrincipal }."
              }
            },
            "enablePurgeProtection": {
              "type": "bool",
              "defaultValue": true,
              "metadata": {
                "description": "Enable purge protection (90-day mandatory soft-delete window, irreversible). Recommended true for production; set false for short-lived lab vaults."
              }
            },
            "softDeleteRetentionInDays": {
              "type": "int",
              "defaultValue": 90,
              "minValue": 7,
              "maxValue": 90,
              "metadata": {
                "description": "Soft-delete retention in days (7-90). Cannot be reduced once the vault is created."
              }
            },
            "location": {
              "type": "string"
            },
            "tags": {
              "type": "object"
            }
          },
          "variables": {
            "certsOfficerRoleId": "a4417e6f-fecd-4de8-b567-7b0420556985"
          },
          "resources": [
            {
              "type": "Microsoft.KeyVault/vaults",
              "apiVersion": "2024-04-01-preview",
              "name": "[parameters('keyVaultName')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "properties": {
                "sku": {
                  "family": "A",
                  "name": "standard"
                },
                "tenantId": "[subscription().tenantId]",
                "enableRbacAuthorization": true,
                "enableSoftDelete": true,
                "softDeleteRetentionInDays": "[parameters('softDeleteRetentionInDays')]",
                "enablePurgeProtection": "[if(parameters('enablePurgeProtection'), true(), null())]",
                "enabledForDeployment": false,
                "enabledForDiskEncryption": false,
                "enabledForTemplateDeployment": false,
                "publicNetworkAccess": "Enabled",
                "networkAcls": {
                  "defaultAction": "Allow",
                  "bypass": "AzureServices"
                }
              }
            },
            {
              "copy": {
                "name": "adminRoleAssignments",
                "count": "[length(parameters('adminPrincipals'))]"
              },
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "scope": "[resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName'))]",
              "name": "[guid(resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName')), parameters('adminPrincipals')[copyIndex()].id, variables('certsOfficerRoleId'))]",
              "properties": {
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('certsOfficerRoleId'))]",
                "principalId": "[parameters('adminPrincipals')[copyIndex()].id]",
                "principalType": "[parameters('adminPrincipals')[copyIndex()].type]"
              },
              "dependsOn": [
                "[resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName'))]"
              ]
            }
          ],
          "outputs": {
            "keyVaultName": {
              "type": "string",
              "value": "[parameters('keyVaultName')]"
            },
            "keyVaultUri": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName')), '2024-04-01-preview').vaultUri]"
            },
            "keyVaultResourceId": {
              "type": "string",
              "value": "[resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName'))]"
            }
          }
        }
      },
      "dependsOn": [
        "securityRg"
      ]
    }
  },
  "outputs": {
    "storageAccountName": {
      "type": "string",
      "metadata": {
        "description": "Storage account name. Use as the value of repo variable ARTIFACTS_STORAGE_ACCOUNT."
      },
      "value": "[reference('storage').outputs.storageAccountName.value]"
    },
    "artifactsLocation": {
      "type": "string",
      "metadata": {
        "description": "Blob container URL. Plug into main.bicepparam → artifactsLocation."
      },
      "value": "[reference('storage').outputs.artifactsLocation.value]"
    },
    "storageResourceGroupName": {
      "type": "string",
      "value": "[parameters('storageResourceGroupName')]"
    },
    "artifactsContainerName": {
      "type": "string",
      "value": "[parameters('artifactsContainerName')]"
    },
    "keyVaultName": {
      "type": "string",
      "metadata": {
        "description": "Key Vault name. Plug into main.bicepparam → keyVaultName. Empty when deployKeyVault = false."
      },
      "value": "[if(parameters('deployKeyVault'), reference('keyVault').outputs.keyVaultName.value, '')]"
    },
    "keyVaultResourceGroupName": {
      "type": "string",
      "value": "[if(parameters('deployKeyVault'), parameters('keyVaultResourceGroupName'), '')]"
    },
    "keyVaultUri": {
      "type": "string",
      "value": "[if(parameters('deployKeyVault'), reference('keyVault').outputs.keyVaultUri.value, '')]"
    }
  }
}